# ==========================================
# Database Connection Details
# ==========================================
# Docker Compose Target Connection:
DATABASE_URL=postgresql+asyncpg://postgres:SecretPassword123!@db:5432/finrag_vault

# Local System Target Connection (uncomment to target a local database):
# DATABASE_URL=postgresql+asyncpg://postgres:SecretPassword123!@localhost:5432/finrag_vault


# ==========================================
# JWT Auth Security Configurations
# ==========================================
SECRET_KEY=37a1f592cd719b02014b2d1847e923e2060b943ea9815ad47a507f354f9a0c7e
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60


# ==========================================
# Qdrant Vector database Configurations
# ==========================================
# Docker Compose Target:
QDRANT_HOST=qdrant

# Local System Target (uncomment to target a local Qdrant server):
# QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=finrag_vault


# ==========================================
# File Upload System Configurations
# ==========================================
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=52428800 # 50MB limits


# ==========================================
# RAG Neural Models
# ==========================================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2


# ==========================================
# Application General Settings
# ==========================================
APP_NAME=FinRAG Vault
DEBUG=true
